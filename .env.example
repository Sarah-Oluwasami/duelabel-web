# Where briefs go. WhatsApp number in international format without "+" (e.g. 2348012345678).
NEXT_PUBLIC_WHATSAPP_NUMBER=2340000000000
NEXT_PUBLIC_CONTACT_EMAIL=duelabeltech@gmail.com

# Email delivery for /api/brief. Create a key at resend.com and verify a sending domain.
# If RESEND_API_KEY is unset, the API route is skipped and the form falls back to FormSubmit.
RESEND_API_KEY=
BRIEF_FROM="Due Label Website <hello@duelabel.com>"
